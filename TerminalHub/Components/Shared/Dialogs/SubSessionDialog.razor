    private Task OnTerminalTypeChanged(TerminalType newType)
    {
        selectedTerminalType = newType;
        return Task.CompletedTask;
    }

    public class SubSessionResult
    {
        public SubSessionType OperationType { get; set; }
        public string BranchName { get; set; } = "";
        public string? WorktreePath { get; set; }
        public TerminalType TerminalType { get; set; } = TerminalType.Terminal;
        public Dictionary<string, string> Options { get; set; } = new();
        public bool UseExistingBranch { get; set; }
        public bool UseDetached { get; set; }
        public string FolderSuffix { get; set; } = "";
        // ユーザー指定のセッション名(任意)。空なら受け取り側で自動命名する
        public string SessionName { get; set; } = "";
        // クローン元のサブセッション。Clone のときだけ入る（フォルダと引き継ぐ設定の取得元）
        public Guid? SourceSessionId { get; set; }
    }

    public enum SubSessionType
    {
        CreateNew,
        AddExisting,
        SamePath,
        NewFolder,
        Clone
    }

    private enum BranchSelectionMode
    {
        NewBranch,
        ExistingBranch,
        Detached
    }


    private enum TabType
    {
        Manage,
        Create,
        Existing,
        SamePath,
        NewFolder,
        // 管理タブの行から入る派生画面。タブ見出しは持たない（クローン元が決まって初めて意味を持つため）
        Clone
    }
}
