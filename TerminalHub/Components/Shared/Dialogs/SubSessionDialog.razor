    // ドラッグ並べ替えの状態。掴んでいる行と、いま重なっている行だけを持つ。
    private int? draggingIndex;
    private int? dragOverIndex;

    private string DragRowClass(int index)
    {
        if (draggingIndex == index)
            return "opacity-50";
        // 落ちる先が分かるように、掴んでいる行以外の重なり先だけ線を出す
        return dragOverIndex == index && draggingIndex.HasValue ? "border-primary" : "";
    }

    private void OnDragStart(int index)
    {
        draggingIndex = index;
        dragOverIndex = index;
    }

    private void OnDragEnd()
    {
        draggingIndex = null;
        dragOverIndex = null;
    }

    /// <summary>
    /// 掴んだ行を落とした位置へ差し込み、その場で保存する。確定ボタンを介さないのは、
    /// 並べ替えが「操作＝結果」で、キャンセルの意味が薄いため（誤操作は戻せばよい）。
    /// </summary>
    private async Task OnDropAsync(int targetIndex)
    {
        var from = draggingIndex;
        OnDragEnd();

        if (!from.HasValue || from.Value == targetIndex)
            return;
        if (from.Value < 0 || from.Value >= manageChildren.Count ||
            targetIndex < 0 || targetIndex >= manageChildren.Count)
            return;

        var moving = manageChildren[from.Value];
        manageChildren.RemoveAt(from.Value);
        manageChildren.Insert(targetIndex, moving);

        if (OnReorder.HasDelegate)
        {
            await OnReorder.InvokeAsync(manageChildren.Select(c => c.SessionId).ToList());
        }
    }

