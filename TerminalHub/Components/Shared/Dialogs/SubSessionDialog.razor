@using TerminalHub.Models
@using TerminalHub.Services
@using Microsoft.Extensions.Localization
@inject IGitService GitService
@inject ILocalStorageService LocalStorage
@inject IAppSettingsService AppSettingsService
@inject IFolderPickerService FolderPicker
@inject IStringLocalizer<SharedResource> L

<div class="modal fade @(IsVisible ? "show" : "")" tabindex="-1" style="display: @(IsVisible ? "block" : "none"); background-color: var(--th-surface-overlay);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-diagram-3 me-2"></i>@L["SubSession.Title"]
                </h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(ParentSessionName))
                {
                    <div class="mb-3">
                        <small class="text-muted">@string.Format(L["SubSession.ParentSessionFormat"], ParentSessionName)</small>
                    </div>
                }

                <!-- タブナビゲーション -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == TabType.Manage ? "active" : "")"
                                @onclick="@(() => activeTab = TabType.Manage)">
                            <i class="bi bi-list-ul me-1"></i>@L["SubSession.Tab.Manage"]
                            @if (manageChildren.Count > 0)
                            {
                                <span class="badge bg-secondary ms-1">@manageChildren.Count</span>
                            }
                        </button>
                    </li>
                    @if (IsGitRepository)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == TabType.Create ? "active" : "")"
                                    @onclick="@(() => activeTab = TabType.Create)">
                                <i class="bi bi-plus-circle me-1"></i>@L["SubSession.Tab.CreateWorktree"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == TabType.Existing ? "active" : "")"
                                    @onclick="@(() => activeTab = TabType.Existing)">
                                <i class="bi bi-folder-plus me-1"></i>@L["SubSession.Tab.ExistingWorktree"]
                            </button>
                        </li>
                    }
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == TabType.SamePath ? "active" : "")"
                                @onclick="@(() => activeTab = TabType.SamePath)">
                            <i class="bi bi-folder me-1"></i>@L["SubSession.Tab.SamePath"]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == TabType.NewFolder ? "active" : "")"
                                @onclick="@(() => activeTab = TabType.NewFolder)">
                            <i class="bi bi-folder-plus me-1"></i>@L["SubSession.Tab.NewFolder"]
                        </button>
                    </li>
                </ul>
                
                <!-- タブコンテンツ -->
                <div class="tab-content">
                    @if (activeTab == TabType.Manage)
                    {
                        <!-- サブセッション管理（並べ替え・クローン） -->
                        <div class="tab-pane fade show active">
                            @if (manageChildren.Count == 0)
                            {
                                <div class="alert alert-secondary mb-0">
                                    <i class="bi bi-info-circle me-2"></i>@L["SubSession.Manage.Empty"]
                                </div>
                            }
                            else
                            {
                                <small class="text-muted d-block mb-2">@L["SubSession.Manage.Help"]</small>
                                <ul class="list-group">
                                    @for (var i = 0; i < manageChildren.Count; i++)
                                    {
                                        var index = i;
                                        var child = manageChildren[index];
                                        <li class="list-group-item d-flex align-items-center gap-2 @DragRowClass(index)"
                                            @ondragover:preventDefault="true"
                                            @ondragenter="() => dragOverIndex = index"
                                            @ondrop="() => OnDropAsync(index)">
                                            @* ドラッグ元はハンドルだけ。行ごと draggable にすると名前の選択や
                                               ボタン操作がドラッグに化けるが、mousedown で立てるフラグ方式だと
                                               ハンドル外で mouseup したときに解除されず残る（Codex レビュー
                                               指摘の P2）。ハンドル自体を draggable にすれば状態を持たずに済む。
                                               受け側（dragover/drop）は行のままなので、行のどこへ落としてもよい。 *@
                                            <span class="text-muted flex-shrink-0 subsession-drag-handle"
                                                  title="@L["SubSession.Manage.DragHandle"]"
                                                  draggable="true"
                                                  @ondragstart="() => OnDragStart(index)"
                                                  @ondragend="OnDragEnd">
                                                <i class="bi bi-grip-vertical"></i>
                                            </span>
                                            <div class="flex-grow-1 text-truncate">
                                                <div class="text-truncate">
                                                    @child.GetDisplayName()
                                                    <span class="badge bg-info ms-1">@child.TerminalType</span>
                                                </div>
                                                <small class="text-muted text-truncate d-block" title="@child.FolderPath">
                                                    @child.FolderPath
                                                </small>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0"
                                                    title="@L["SubSession.Manage.CloneTitle"]"
                                                    disabled="@isProcessing"
                                                    @onclick="() => StartClone(child)">
                                                <i class="bi bi-copy me-1"></i>@L["SubSession.Manage.Clone"]
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                    title="@L["SubSession.Manage.ArchiveTitle"]"
                                                    disabled="@isProcessing"
                                                    @onclick="() => ArchiveChildAsync(child)">
                                                <i class="bi bi-archive me-1"></i>@L["SubSession.Manage.Archive"]
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }

                            @* アーカイブ済みもここに出す。「一覧から消したいだけ」の受け皿がアーカイブなので、
                               戻す操作までこの画面で完結しないと、アーカイブ一覧を探しに行く羽目になる。 *@
                            @if (ArchivedChildSessions.Count > 0)
                            {
                                <div class="mt-4">
                                    @* 既定は畳んで件数だけ。戻す操作は稀なので、常時開いていると
                                       本命の（一覧に出ている）サブセッションが下へ押しやられる。 *@
                                    <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none px-0"
                                            @onclick="() => archivedExpanded = !archivedExpanded">
                                        <i class="bi @(archivedExpanded ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                        <i class="bi bi-archive me-1"></i>@L["SubSession.Manage.ArchivedHeading"]
                                        <span class="badge bg-secondary ms-1">@ArchivedChildSessions.Count</span>
                                    </button>
                                    @if (archivedExpanded)
                                    {
                                    <small class="text-muted d-block mb-2">@L["SubSession.Manage.ArchivedHelp"]</small>
                                    <ul class="list-group">
                                        @foreach (var archived in ArchivedChildSessions)
                                        {
                                            var archivedChild = archived;
                                            <li class="list-group-item d-flex align-items-center gap-2 opacity-75">
                                                <div class="flex-grow-1 text-truncate">
                                                    <div class="text-truncate">
                                                        @archivedChild.GetDisplayName()
                                                        <span class="badge bg-secondary ms-1">@archivedChild.TerminalType</span>
                                                    </div>
                                                    <small class="text-muted text-truncate d-block" title="@archivedChild.FolderPath">
                                                        @archivedChild.FolderPath
                                                    </small>
                                                </div>
                                                <button type="button" class="btn btn-outline-success btn-sm flex-shrink-0"
                                                        title="@L["SubSession.Manage.RestoreTitle"]"
                                                        disabled="@isProcessing"
                                                        @onclick="() => RestoreChildAsync(archivedChild)">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>@L["SubSession.Manage.Restore"]
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (activeTab == TabType.Clone && cloneSource != null)
                    {
                        <!-- クローン作成（元のフォルダ・設定・専用コマンドを引き継ぐ） -->
                        <div class="tab-pane fade show active">
                            <div class="alert alert-info">
                                <i class="bi bi-copy me-2"></i>
                                @string.Format(L["SubSession.Clone.SourceFormat"], cloneSource.GetDisplayName())
                                <div class="small text-truncate mt-1" title="@cloneSource.FolderPath">@cloneSource.FolderPath</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["SubSession.SessionName"]</label>
                                <input type="text" class="form-control" @bind="sessionName"
                                       placeholder="@L["SubSession.SessionName.Placeholder"]" />
                                <small class="form-text text-muted">@L["SubSession.SessionName.Help"]</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["SubSession.Clone.TerminalType"]</label>
                                <select class="form-select" value="@((int)selectedTerminalType)"
                                        @onchange="OnCloneTerminalTypeChanged">
                                    @foreach (var type in CloneSelectableTypes)
                                    {
                                        <option value="@((int)type)">@type</option>
                                    }
                                </select>
                            </div>

                            @* 同じ種別なら元セッションの起動オプションをそのまま引き継ぐ。ここで
                               SessionOptionsSelector を出すと、セレクタが常に「新規の既定値一式」を
                               書き出すため、元の read-only／承認拒否／ネットワーク無効などが黙って
                               緩む（Codex レビュー指摘の P1）。種別を変えたときだけ、その種別の
                               設定を選ばせる。 *@
                            @if (selectedTerminalType == cloneSource.TerminalType)
                            {
                                <div class="alert alert-secondary mb-0">
                                    <i class="bi bi-info-circle me-2"></i>@L["SubSession.Clone.Info"]
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@L["SubSession.Clone.TypeChangedInfo"]
                                </div>
                                <div class="mt-3">
                                    <SessionOptionsSelector @ref="optionsSelectorClone"
                                                          SelectedType="selectedTerminalType"
                                                          SelectedTypeChanged="OnTerminalTypeChanged"
                                                          @bind-StartupCommand="startupCommand"
                                                          ClaudeOptions="claudeOptions"
                                                          GeminiOptions="geminiOptions"
                                                          CodexOptions="codexOptions" />
                                </div>
                            }
                        </div>
                    }
                    else if (activeTab == TabType.Create)
                    {
                        <!-- 新規Worktree作成 -->
                        <div class="tab-pane active">
                            @if (!IsGitRepository)
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>@L["SubSession.GitRequired.Title"]</strong><br/>
                                    @L["SubSession.GitRequired.CreateWorktree"]
                                </div>
                            }
                            else
                            {
                            <div class="mb-3">
                                <label class="form-label">@L["SubSession.BranchSelection.Label"]</label>
                                <div class="btn-group d-flex mb-2" role="group">
                                    <input type="radio" class="btn-check" name="branchOption" id="newBranch"
                                           checked="@(branchSelectionMode == BranchSelectionMode.NewBranch)"
                                           @onclick="@(() => branchSelectionMode = BranchSelectionMode.NewBranch)">
                                    <label class="btn btn-outline-secondary" for="newBranch">@L["SubSession.BranchSelection.New"]</label>

                                    <input type="radio" class="btn-check" name="branchOption" id="existingBranch"
                                           checked="@(branchSelectionMode == BranchSelectionMode.ExistingBranch)"
                                           @onclick="@(() => branchSelectionMode = BranchSelectionMode.ExistingBranch)">
                                    <label class="btn btn-outline-secondary" for="existingBranch">@L["SubSession.BranchSelection.Existing"]</label>

                                    <input type="radio" class="btn-check" name="branchOption" id="detachedBranch"
                                           checked="@(branchSelectionMode == BranchSelectionMode.Detached)"
                                           @onclick="@(() => branchSelectionMode = BranchSelectionMode.Detached)">
                                    <label class="btn btn-outline-secondary" for="detachedBranch">@L["SubSession.BranchSelection.Detached"]</label>
                                </div>
                            </div>

                            @if (branchSelectionMode == BranchSelectionMode.NewBranch)
                            {
                                <div class="mb-3">
                                    <label for="branchName" class="form-label">@L["SubSession.NewBranch.Label"]</label>
                                    <input type="text" class="form-control" id="branchName"
                                           @bind="branchName"
                                           @bind:event="oninput"
                                           @onkeydown="OnKeyDown"
                                           placeholder="feature/new-feature"
                                           autofocus>
                                    <small class="form-text text-muted">
                                        @L["SubSession.NewBranch.Help"]
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(branchName) && !IsValidBranchName(branchName))
                                    {
                                        <div class="text-danger small mt-1">
                                            <i class="bi bi-exclamation-circle me-1"></i>@L["SubSession.NewBranch.Invalid"]
                                        </div>
                                    }
                                </div>
                            }
                            else if (branchSelectionMode == BranchSelectionMode.Detached)
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    @L["SubSession.Detached.Help"]
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <label for="existingBranchSelect" class="form-label">@L["SubSession.ExistingBranch.Label"]</label>
                                    @if (availableBranches == null)
                                    {
                                        <div class="text-center">
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            @L["SubSession.ExistingBranch.Loading"]
                                        </div>
                                    }
                                    else if (availableBranches.Count == 0)
                                    {
                                        <div class="alert alert-warning">
                                            @L["SubSession.ExistingBranch.Empty"]
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="form-select" id="existingBranchSelect"
                                                @onchange="OnExistingBranchSelected">
                                            <option value="">@L["SubSession.ExistingBranch.Placeholder"]</option>
                                            @foreach (var branch in availableBranches)
                                            {
                                                <option value="@branch">@branch</option>
                                            }
                                        </select>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(selectedExistingBranch) && branchWorktreeInfo != null)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <strong>@L["SubSession.BranchExistingWorktree.Title"]</strong><br/>
                                        <span>@string.Format(L["SubSession.BranchExistingWorktree.PathFormat"], branchWorktreeInfo.Path)</span><br/>
                                        <small>@L["SubSession.BranchExistingWorktree.Help"]</small>
                                    </div>
                                }
                            }
                            
                            <!-- フォルダ名サフィックス(任意) -->
                            <div class="mb-3">
                                <label for="folderSuffix" class="form-label">@L["SubSession.FolderSuffix.Label"]</label>
                                <input type="text" class="form-control" id="folderSuffix"
                                       @bind="folderSuffix"
                                       @bind:event="oninput"
                                       @onkeydown="OnKeyDown"
                                       placeholder="@GetFolderSuffixPlaceholder()">
                                <small class="form-text text-muted">
                                    @L["SubSession.FolderSuffix.Help"]
                                </small>
                                @if (!string.IsNullOrWhiteSpace(folderSuffix) && !IsValidFolderSuffix(folderSuffix))
                                {
                                    <div class="text-danger small mt-1">
                                        <i class="bi bi-exclamation-circle me-1"></i>@L["SubSession.FolderSuffix.Invalid"]
                                    </div>
                                }
                            </div>

                            <!-- 共通オプションセレクター -->
                            <SessionOptionsSelector @ref="optionsSelector"
                                                  SelectedType="selectedTerminalType"
                                                  SelectedTypeChanged="OnTerminalTypeChanged"
                                                  @bind-StartupCommand="startupCommand"
                                                  ClaudeOptions="claudeOptions"
                                                  GeminiOptions="geminiOptions"
                                                  CodexOptions="codexOptions"
                                                  DisableContinueOption="false" />
                            }
                        </div>
                    }
                    else if (activeTab == TabType.Existing)
                    {
                        <!-- 既存Worktree追加 -->
                        <div class="tab-pane active">
                            @if (!IsGitRepository)
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>@L["SubSession.GitRequired.Title"]</strong><br/>
                                    @L["SubSession.GitRequired.ExistingWorktree"]
                                </div>
                            }
                            else
                            {
                            <div class="mb-3">
                                <label for="worktreePath" class="form-label">@L["SubSession.ExistingWorktree.Label"]</label>
                                @if (availableWorktrees == null)
                                {
                                    <div class="text-center">
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        @L["SubSession.ExistingWorktree.Loading"]
                                    </div>
                                }
                                else if (availableWorktrees.Count == 0)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        @L["SubSession.ExistingWorktree.Empty"]
                                    </div>
                                }
                                else
                                {
                                    <select class="form-select" id="worktreeSelect"
                                            value="@selectedWorktreePath"
                                            @onchange="OnWorktreeSelected">
                                        <option value="">@L["SubSession.ExistingWorktree.Placeholder"]</option>
                                        @foreach (var worktree in availableWorktrees)
                                        {
                                            @* 表示は worktree 名のみ。以前はブランチ名を括弧で出していたが、
                                               detached HEAD の worktree はブランチを持たないため「()」になり
                                               何を選んでいるか分からなかった *@
                                            <option value="@worktree.Path">
                                                @WorktreeNaming.GetShortName(ParentSessionPath, worktree.Path)
                                                @if (worktree.IsMain)
                                                {
                                                    <text> @L["SubSession.WorktreeMainSuffix"]</text>
                                                }
                                            </option>
                                        }
                                    </select>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(selectedWorktreePath))
                            {
                                <!-- セッションオプション選択 -->
                                <div class="mt-3">
                                    <SessionOptionsSelector @ref="optionsSelectorExistingWorktree"
                                                          SelectedType="selectedTerminalType"
                                                          SelectedTypeChanged="OnTerminalTypeChanged"
                                                          @bind-StartupCommand="startupCommand"
                                                          ClaudeOptions="claudeOptions"
                                                          GeminiOptions="geminiOptions"
                                                          CodexOptions="codexOptions" />
                                </div>
                            }
                            }
                        </div>
                    }
                    else if (activeTab == TabType.SamePath)
                    {
                        <!-- 同じフォルダで開く -->
                        <div class="tab-pane active">
                            <!-- セッション名(任意) -->
                            <div class="mb-3">
                                <label for="samePathSessionName" class="form-label">@L["SubSession.SessionName.Label"]</label>
                                <input type="text" class="form-control" id="samePathSessionName"
                                       @bind="sessionName"
                                       @bind:event="oninput"
                                       @onkeydown="OnKeyDown"
                                       placeholder="@L["SubSession.SessionName.Placeholder"]">
                                <small class="form-text text-muted">
                                    @L["SubSession.SessionName.Help"]
                                </small>
                            </div>

                            <!-- 共通オプションセレクター -->
                            <SessionOptionsSelector @ref="optionsSelectorSamePath"
                                                  SelectedType="selectedTerminalType"
                                                  SelectedTypeChanged="OnTerminalTypeChanged"
                                                  @bind-StartupCommand="startupCommand"
                                                  ClaudeOptions="claudeOptions"
                                                  GeminiOptions="geminiOptions"
                                                  CodexOptions="codexOptions" />
                            
                            @if (ParentSessionName != null)
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    @string.Format(L["SubSession.SamePath.InfoFormat"], ParentSessionName)
                                </div>
                            }
                        </div>
                    }
                    else if (activeTab == TabType.NewFolder)
                    {
                        <!-- 新しいフォルダで開く -->
                        <div class="tab-pane active">
                            <div class="mb-3">
                                <label for="newFolderPath" class="form-label">@L["SubSession.NewFolder.Label"]</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="newFolderPath"
                                           @bind="newFolderPath"
                                           @bind:event="oninput"
                                           @onkeydown="OnKeyDown"
                                           placeholder="@L["SubSession.NewFolder.Placeholder"]"
                                           autofocus>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="SelectFolderDialog">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    @L["SubSession.NewFolder.Help"]
                                </small>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(newFolderPath))
                            {
                                <!-- セッション名(任意) -->
                                <div class="mb-3">
                                    <label for="newFolderSessionName" class="form-label">@L["SubSession.SessionName.Label"]</label>
                                    <input type="text" class="form-control" id="newFolderSessionName"
                                           @bind="sessionName"
                                           @bind:event="oninput"
                                           @onkeydown="OnKeyDown"
                                           placeholder="@L["SubSession.SessionName.Placeholder"]">
                                    <small class="form-text text-muted">
                                        @L["SubSession.SessionName.Help"]
                                    </small>
                                </div>

                                <!-- セッションオプション選択 -->
                                <div class="mt-3">
                                    <SessionOptionsSelector @ref="optionsSelectorNewFolder"
                                                          SelectedType="selectedTerminalType"
                                                          SelectedTypeChanged="OnTerminalTypeChanged"
                                                          @bind-StartupCommand="startupCommand"
                                                          ClaudeOptions="claudeOptions"
                                                          GeminiOptions="geminiOptions"
                                                          CodexOptions="codexOptions" />
                                </div>
                                
                                <div class="alert alert-info mt-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    @string.Format(L["SubSession.NewFolder.InfoFormat"], newFolderPath)
                                </div>
                            }
                        </div>
                    }
                </div>
                
                <ErrorAlert @bind-ErrorMessage="errorMessage" />
            </div>
            <div class="modal-footer">
                @if (activeTab == TabType.Clone)
                {
                    <button type="button" class="btn btn-outline-secondary me-auto" @onclick="CancelClone" disabled="@isProcessing">
                        <i class="bi bi-arrow-left me-1"></i>@L["SubSession.Clone.Back"]
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@isProcessing">
                    @(activeTab == TabType.Manage ? L["Common.Close"] : L["Common.Cancel"])
                </button>
                @* 管理タブの操作は行ごとのボタンで完結する（並べ替えは即時保存）ので、実行ボタンは出さない *@
                @if (activeTab != TabType.Manage)
                {
                <button type="button" class="btn btn-success" @onclick="ProcessOperation"
                        disabled="@(!CanProcess || isProcessing)">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-@GetButtonIcon() me-2"></i>
                    }
                    @GetButtonText()
                </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? ParentSessionName { get; set; }
    [Parameter] public Guid? ParentSessionId { get; set; }
    [Parameter] public bool IsGitRepository { get; set; }
    [Parameter] public TerminalType ParentTerminalType { get; set; } = TerminalType.Terminal;
    [Parameter] public EventCallback<SubSessionResult> OnSubSessionOperation { get; set; }
    /// <summary>この親に属するサブセッション（表示順）。管理タブの並べ替え・クローンの対象。</summary>
    [Parameter] public List<SessionInfo> ChildSessions { get; set; } = new();
