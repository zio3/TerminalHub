    /// <summary>
    /// サブセッションをアーカイブする（一覧から消す）。ConPTY は落ちるので、
    /// 「動かしたまま隠す」用途には使えない＝隠れて動き続けるセッションは作らない。
    /// </summary>
    private async Task ArchiveChildAsync(SessionInfo child)
    {
        if (!OnArchiveChild.HasDelegate)
            return;

        // 先に手元の並びからも抜く。親が返してくるまで消えないと、押した手応えが無い。
        manageChildren.RemoveAll(c => c.SessionId == child.SessionId);
        await OnArchiveChild.InvokeAsync(child.SessionId);
    }

    private async Task RestoreChildAsync(SessionInfo child)
    {
        if (!OnRestoreChild.HasDelegate)
            return;

        await OnRestoreChild.InvokeAsync(child.SessionId);
    }
