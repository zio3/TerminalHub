    private string sessionName = "";

    [Parameter] public string? ParentSessionPath { get; set; }
    
    private bool _wasVisible = false;
    
    protected override async Task OnParametersSetAsync()
    {
        // IsVisibleがfalseからtrueに変わった時のみ初期化
        if (IsVisible && !_wasVisible)
        {
            // ダイアログが表示されたときにリセット。
            // 入り口を「管理」に一本化したので、既定は常に管理タブ（作成はそこから選ぶ）。
            manageChildren = ChildSessions.ToList();
            cloneSource = null;
            archivedExpanded = false;
            activeTab = TabType.Manage;
            branchName = "";
            errorMessage = "";
            isProcessing = false;
            branchSelectionMode = BranchSelectionMode.NewBranch;
            selectedExistingBranch = "";
            folderSuffix = "";
            // 親セッションの TerminalType を初期値として引き継ぐ
            selectedTerminalType = ParentTerminalType;

            // 直近の選択を LocalStorage から復元
            await LoadLastBranchSelectionMode();
            availableBranches = null;
            availableWorktrees = null;
            selectedWorktreePath = "";
            branchWorktreeInfo = null;
            startupCommand = "";
            claudeOptions = new();
            geminiOptions = new();
            codexOptions = new();
            // CLI モード系の直近選択も復元（SessionCreateDialog とキー共有）
            await LoadLastUsedCliModes();
            newFolderPath = "";
            sessionName = "";
            
            // 親セッションのパスがあり、Gitリポジトリの場合はブランチ一覧とworktree一覧を取得
            if (!string.IsNullOrEmpty(ParentSessionPath) && IsGitRepository)
            {
                await LoadAvailableBranches();
                await LoadAvailableWorktrees();
            }
        }
        else if (IsVisible)
        {
            // 開いたまま親側で増減したとき（アーカイブ・復元・作成）に追随する。
            // 並べ替え直後の再描画でも通るので、順序ではなく「顔ぶれ」が変わったときだけ作り直す
            // （毎回作り直すと、保存が返る前の手元の並びを親の古い並びで上書きしてしまう）。
            var currentIds = manageChildren.Select(c => c.SessionId).ToHashSet();
            if (!currentIds.SetEquals(ChildSessions.Select(c => c.SessionId)))
            {
                manageChildren = ChildSessions.ToList();
            }
        }

        _wasVisible = IsVisible;
    }

    private async Task ProcessOperation()
    {
        if (!CanProcess)
            return;

        // NewFolder は手入力なので、貼り付け由来の前後クォートを剥がしてフィールドへ書き戻す。
        // これで以降の表示・結果すべてがクリーンな値で揃う（SessionCreateDialog と同じ方式）。
        if (activeTab == TabType.NewFolder)
        {
            newFolderPath = PathInputHelper.NormalizeFolderInput(newFolderPath);
        }

        isProcessing = true;
        errorMessage = "";

        try
        {
            var result = new SubSessionResult
            {
                OperationType = activeTab switch
                {
                    TabType.Create => SubSessionType.CreateNew,
                    TabType.Existing => SubSessionType.AddExisting,
                    TabType.SamePath => SubSessionType.SamePath,
                    TabType.NewFolder => SubSessionType.NewFolder,
                    TabType.Clone => SubSessionType.Clone,
                    _ => SubSessionType.CreateNew
                },
                BranchName = activeTab == TabType.Create
                    ? branchSelectionMode switch
                    {
                        BranchSelectionMode.NewBranch => branchName,
                        BranchSelectionMode.ExistingBranch => selectedExistingBranch,
                        _ => ""
                    }
                    : availableWorktrees?.FirstOrDefault(w => w.Path == selectedWorktreePath)?.BranchName ?? "",
                // NewFolder の newFolderPath は ProcessOperation 冒頭で正規化済み（Existing はドロップダウン選択）
                WorktreePath = activeTab == TabType.Existing ? selectedWorktreePath :
                               activeTab == TabType.NewFolder ? newFolderPath : null,
                TerminalType = selectedTerminalType,
                Options = activeTab switch
                {
                    TabType.Create => optionsSelector?.GetOptions() ?? new Dictionary<string, string>(),
                    TabType.Existing => optionsSelectorExistingWorktree?.GetOptions() ?? new Dictionary<string, string>(),
                    TabType.SamePath => optionsSelectorSamePath?.GetOptions() ?? new Dictionary<string, string>(),
                    TabType.NewFolder => optionsSelectorNewFolder?.GetOptions() ?? new Dictionary<string, string>(),
                    TabType.Clone => optionsSelectorClone?.GetOptions() ?? new Dictionary<string, string>(),
                    _ => new Dictionary<string, string>()
                },
                UseExistingBranch = activeTab == TabType.Create && branchSelectionMode == BranchSelectionMode.ExistingBranch,
                UseDetached = activeTab == TabType.Create && branchSelectionMode == BranchSelectionMode.Detached,
                FolderSuffix = activeTab == TabType.Create ? folderSuffix?.Trim() ?? "" : "",
                // セッション名は SamePath/NewFolder/Clone タブのみ有効。未入力なら空(=受け取り側で自動命名)
                SessionName = (activeTab == TabType.SamePath || activeTab == TabType.NewFolder || activeTab == TabType.Clone)
                    ? sessionName?.Trim() ?? ""
                    : "",
                SourceSessionId = activeTab == TabType.Clone ? cloneSource?.SessionId : null
            };

            // Create タブの選択結果を「直近の選択」として LocalStorage に保存
            if (activeTab == TabType.Create)
            {
                await SaveLastBranchSelectionMode();
            }

            await OnSubSessionOperation.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(L["SubSession.ErrorFormat"], ex.Message);
            isProcessing = false;
        }
    }


    private bool IsValidBranchName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return false;

        var reserved = new[] { "HEAD", "FETCH_HEAD", "ORIG_HEAD", "MERGE_HEAD" };
        if (reserved.Contains(name, StringComparer.OrdinalIgnoreCase))
            return false;

        var invalidChars = new[] { ' ', '~', '^', ':', '?', '*', '[', '\\' };
        if (invalidChars.Any(c => name.Contains(c)))
            return false;
            
        if (name.Contains(".."))
            return false;

        if (name.StartsWith('.') || name.StartsWith('-') || name.EndsWith('.') || name.EndsWith('/'))
            return false;

        return true;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isProcessing && CanProcess)
        {
            await ProcessOperation();
        }
        else if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }
    
    private async Task SelectFolderDialog()
    {
        try
        {
            // Windowsネイティブのフォルダ選択ダイアログを表示。
            // 初期ディレクトリは親セッションのフォルダ（あれば）にする。
            var selected = await FolderPicker.PickFolderAsync(ParentSessionPath);
            if (!string.IsNullOrEmpty(selected))
            {
                newFolderPath = selected;
            }
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(L["SubSession.ErrorFormat"], ex.Message);
        }
    }

    // SessionCreateDialog が保存した CLI モードの直近選択を、初期値として読むだけ。
    // SubSessionDialog 側で書き戻しはしない (値の発生源は新規セッション作成画面に一元化)。
    private Task LoadLastUsedCliModes()
    {
        try
        {
            var defaults = AppSettingsService.GetSettings().SessionDefaults;

            if (defaults.LastClaudePermissionMode != null && ValidClaudePermissionModes.Contains(defaults.LastClaudePermissionMode))
            {
                claudeOptions.PermissionMode = defaults.LastClaudePermissionMode;
            }

            if (defaults.LastGeminiApprovalMode != null && ValidGeminiApprovalModes.Contains(defaults.LastGeminiApprovalMode))
            {
                geminiOptions.ApprovalMode = defaults.LastGeminiApprovalMode;
            }

            // Yolo（承認・サンドボックス完全バイパス）は危険なため「最後の選択」を復元せず、
            // 新規サブセッションでは常に OFF 既定にする（安全側）。

            var isLegacyCodexDefault = defaults.LastCodexPermissionPreset == "codex-default";
            if (isLegacyCodexDefault)
            {
                // 旧「Codex標準」は上書きなしだったため、同じ実効値をカスタムとして維持する。
                codexOptions.PermissionPreset = "custom";
                codexOptions.SandboxMode = "";
                codexOptions.ApprovalPolicy = "";
                codexOptions.ApprovalReviewer = "";
                codexOptions.WindowsSandbox = "";
                codexOptions.NetworkAccess = "";
                codexOptions.WebSearchMode = "";
            }
            else if (defaults.LastCodexPermissionPreset != null && ValidCodexPermissionPresets.Contains(defaults.LastCodexPermissionPreset))
            {
                codexOptions.PermissionPreset = defaults.LastCodexPermissionPreset;
            }
            else if (defaults.LastCodexSandboxMode != null || defaults.LastCodexApprovalPolicy != null ||
                     defaults.LastCodexAutoReviewApprovals != null || defaults.LastCodexSearchEnabled != null)
            {
                codexOptions.PermissionPreset = "custom";
                codexOptions.WindowsSandbox = "";
                codexOptions.NetworkAccess = "";
                codexOptions.ApprovalReviewer = "";
                codexOptions.WebSearchMode = "";
            }

            if (!isLegacyCodexDefault && defaults.LastCodexSandboxMode != null && ValidCodexSandboxModes.Contains(defaults.LastCodexSandboxMode))
            {
                codexOptions.SandboxMode = defaults.LastCodexSandboxMode;
            }

            if (!isLegacyCodexDefault && defaults.LastCodexApprovalPolicy != null && ValidCodexApprovalPolicies.Contains(defaults.LastCodexApprovalPolicy))
            {
                codexOptions.ApprovalPolicy = defaults.LastCodexApprovalPolicy;
            }

            if (!isLegacyCodexDefault && defaults.LastCodexApprovalReviewer != null && ValidCodexApprovalReviewers.Contains(defaults.LastCodexApprovalReviewer))
            {
                codexOptions.ApprovalReviewer = defaults.LastCodexApprovalReviewer;
            }
            else if (!isLegacyCodexDefault && defaults.LastCodexAutoReviewApprovals.HasValue)
            {
                codexOptions.ApprovalReviewer = defaults.LastCodexAutoReviewApprovals.Value ? "auto_review" : "";
            }
            if (!isLegacyCodexDefault && defaults.LastCodexWindowsSandbox != null && ValidCodexWindowsSandboxes.Contains(defaults.LastCodexWindowsSandbox))
            {
                codexOptions.WindowsSandbox = defaults.LastCodexWindowsSandbox;
            }
            if (!isLegacyCodexDefault && defaults.LastCodexNetworkAccess != null && ValidCodexNetworkAccess.Contains(defaults.LastCodexNetworkAccess))
            {
                codexOptions.NetworkAccess = defaults.LastCodexNetworkAccess;
            }
            if (!isLegacyCodexDefault && defaults.LastCodexWebSearchMode != null && ValidCodexWebSearchModes.Contains(defaults.LastCodexWebSearchMode))
            {
                codexOptions.WebSearchMode = defaults.LastCodexWebSearchMode;
            }
            else if (!isLegacyCodexDefault && defaults.LastCodexSearchEnabled.HasValue)
            {
                codexOptions.WebSearchMode = defaults.LastCodexSearchEnabled.Value ? "live" : "";
            }
            codexOptions.ResumeLast = defaults.LastCodexResumeLast ?? codexOptions.ResumeLast;
            codexOptions.NoAltScreen = defaults.LastCodexNoAltScreen ?? codexOptions.NoAltScreen;
        }
        catch
        {
            // 失敗してもデフォルト値のまま続行
        }
        return Task.CompletedTask;
    }

    private async Task LoadLastBranchSelectionMode()
    {
        try
        {
            var saved = await LocalStorage.GetAsync<string>(LAST_BRANCH_SELECTION_MODE_KEY);
            if (!string.IsNullOrEmpty(saved) && ValidBranchSelectionModes.Contains(saved)
                && Enum.TryParse<BranchSelectionMode>(saved, out var mode))
            {
                branchSelectionMode = mode;
            }
        }
        catch
        {
            // LocalStorage アクセス失敗時はデフォルト (NewBranch) のまま
        }
    }

    private async Task SaveLastBranchSelectionMode()
    {
        try
        {
            await LocalStorage.SetAsync(LAST_BRANCH_SELECTION_MODE_KEY, branchSelectionMode.ToString());
        }
        catch
        {
            // LocalStorage アクセス失敗時は無視
        }
    }

    private async Task LoadAvailableBranches()
    {
        if (string.IsNullOrEmpty(ParentSessionPath))
            return;
            
        try
        {
            var gitInfo = await GitService.GetGitInfoAsync(ParentSessionPath);
            if (gitInfo != null && gitInfo.AvailableBranches.Count > 0)
            {
                // 現在のブランチを除外
                availableBranches = gitInfo.AvailableBranches
                    .Where(b => b != gitInfo.CurrentBranch)
                    .ToList();
            }
            else
            {
                availableBranches = new List<string>();
            }
        }
        catch
        {
            availableBranches = new List<string>();
        }
    }
    
    private async Task LoadAvailableWorktrees()
    {
        if (string.IsNullOrEmpty(ParentSessionPath))
            return;
            
        try
        {
            var worktrees = await GitService.GetWorktreeListAsync(ParentSessionPath);
            // 現在のフォルダ（メインworktree）を除外
            availableWorktrees = worktrees.Where(w => !w.IsMain).ToList();
        }
        catch
        {
            availableWorktrees = new List<WorktreeInfo>();
        }
    }
    
    private void OnExistingBranchSelected(ChangeEventArgs e)
    {
        var branchName = e.Value?.ToString() ?? "";
        selectedExistingBranch = branchName;
        
        // 選択されたブランチのworktreeが存在するかチェック
        if (!string.IsNullOrEmpty(branchName) && availableWorktrees != null)
        {
            branchWorktreeInfo = availableWorktrees.FirstOrDefault(w => w.BranchName == branchName);
        }
        else
        {
            branchWorktreeInfo = null;
        }
    }
    
    private void OnWorktreeSelected(ChangeEventArgs e)
    {
        selectedWorktreePath = e.Value?.ToString() ?? "";
        StateHasChanged();
    }
    
