    private async Task HandleSessionCommandSave(CustomCommand command)
    {
        var editingIndex = (commandEditDialogIndex is int i && i >= 0 && i < editingSessionCommands.Count)
            ? i : (int?)null;

        // title はセッション専用コマンドの中で一意にする。MCP の remove_command が title 指定であり、
        // 重複すると人間からもどちらを消しているのか分からなくなるため、UI 側でも同じ規則で弾く。
        // （グローバルや親から伝搬されたコマンドとの同名は従来どおり許す）
        if (!string.IsNullOrEmpty(command.Title) &&
            editingSessionCommands
                .Where((c, idx) => idx != editingIndex &&
                    string.Equals(c.Title, command.Title, StringComparison.Ordinal))
                .Any())
        {
            sessionCommandError = string.Format(L["Settings.Commands.DuplicateTitle"], command.Title);
            return;
        }
        sessionCommandError = null;

        if (editingIndex is int idx2)
        {
            // 人間が手を入れた時点で「人間のもの」に変える。AI が作ったものは同じ手順で作り直せるが、
            // 人間が調整したものは失うと戻せないため、MCP の remove_command から守る。
            command.CreatedByAgent = false;
            editingSessionCommands[idx2] = command; // 編集：既存位置に上書き
        }
        else
        {
            editingSessionCommands.Add(command); // 新規：末尾に追加（UI 発なので CreatedByAgent は既定の false）
        }
        // ダイアログ側が Close を呼び OnSessionCommandDialogVisibleChanged 経由で state クリア
        await PersistSessionCommandsAsync(); // 即時保存
    }

    private void OnSessionCommandDialogVisibleChanged(bool visible)
    {
        commandEditDialogVisible = visible;
        if (!visible)
        {
            commandEditDialogIndex = null;
            commandEditDialogSource = null;
            commandEditDialogTerminalLabel = null;
        }
    }

    private async Task RemoveSessionCommand(int index)
    {
        if (index >= 0 && index < editingSessionCommands.Count)
        {
            editingSessionCommands.RemoveAt(index);
            await PersistSessionCommandsAsync(); // 即時保存
        }
    }

    /// <summary>
    /// 専用コマンドの編集内容を実セッション（sessionInfo）へ反映し、呼び出し元に永続化を依頼する。
    /// サブダイアログでの追加/編集/削除を「その場で保存」するために使う（本体ダイアログの保存を待たない）。
    /// </summary>
    private async Task PersistSessionCommandsAsync()
    {
        if (sessionInfo == null)
            return;

        // ダイアログを開いている間に MCP(add_command) から増えたコマンドを取り込む。
        // 編集バッファは開いた時点のスナップショットなので、そのまま書き戻すと
        // その間の追加を黙って消してしまう（過去に b03f90d で同種の消失を修正している）。
        // 逆方向（開いている間の remove_command）は復活する形になるが、消えるより安全側であり、
        // 対象は AI が登録したもの＝同じ手順で作り直せるものに限られる。
        var externallyAdded = sessionInfo.SessionCommands
            .Where(c => c.CreatedByAgent
                && !string.IsNullOrEmpty(c.Title)
                && !loadedSessionCommandTitles.Contains(c.Title!)
                && !editingSessionCommands.Any(e => string.Equals(e.Title, c.Title, StringComparison.Ordinal)))
            .ToList();
        if (externallyAdded.Count > 0)
        {
            editingSessionCommands.AddRange(externallyAdded);
            foreach (var c in externallyAdded)
                loadedSessionCommandTitles.Add(c.Title!);
        }

        // editingSessionCommands をディープコピーして実セッションへ反映（以降の編集で相互に壊さないため）
        sessionInfo.SessionCommands = editingSessionCommands
            .Select(c => new CustomCommand
            {
                Title = c.Title,
                CommandText = c.CommandText,
                Type = c.Type,
                KeyName = c.KeyName,
                GroupName = c.GroupName,
                SendMode = c.SendMode,
                PropagateToChildren = c.PropagateToChildren,
                // ここで落とすと、別のコマンドを1つ追加/削除しただけで既存の AI 登録が
                // すべて人間扱いになってしまう。落とすのは編集した項目だけ（HandleSessionCommandSave）
                CreatedByAgent = c.CreatedByAgent
            })
            .ToList();

        // 呼び出し元（Root）が DB 永続化とクイック送信バーの更新を行う
        await OnSessionCommandsChanged.InvokeAsync();
    }

    private static string GetTerminalTypeDisplayName(TerminalType type) => type switch
    {
        TerminalType.ClaudeCode => "Claude Code",
        TerminalType.GeminiCLI => "Gemini CLI",
        TerminalType.CodexCLI => "Codex CLI",
        TerminalType.Antigravity => "Antigravity",
        TerminalType.Grok => "Grok",
        _ => "Terminal"
    };

    /// <summary>一覧の行に出すコマンド本文の表示用要約。複数行は先頭行 + "…" で短縮する。</summary>
    private static string SummarizeCommandText(string commandText)
    {
        if (string.IsNullOrEmpty(commandText)) return commandText;
        var newline = commandText.IndexOfAny(new[] { '\r', '\n' });
        return newline < 0 ? commandText : commandText.Substring(0, newline) + " …";
    }

}
