@using TerminalHub.Models
@using TerminalHub.Services
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using System.Diagnostics
@using System.IO
@inject ISessionManager SessionManager
@inject IJSRuntime JSRuntime
@inject ILogger<SessionSettingsDialog> Logger
@inject ISessionMemoRepository MemoRepository
@inject IStringLocalizer<SharedResource> L
@inject IExplorerLauncherService ExplorerLauncher
@inject IGitService GitService

<div class="modal fade @(IsVisible ? "show" : "")" tabindex="-1" style="display: @(IsVisible ? "block" : "none"); background-color: var(--th-surface-overlay);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-gear me-2"></i>@L["SessionSettings.Title"]
                </h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (sessionInfo != null)
                {
                    <div class="mb-3">
                        <h6 class="text-muted">@L["SessionSettings.Info.Header"]</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">@L["SessionSettings.Info.SessionName"]</small><br/>
                                <strong>@sessionInfo.GetDisplayName()</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">@L["SessionSettings.Info.Folder"]</small><br/>
                                <div class="d-flex align-items-start">
                                    <code class="flex-grow-1 me-2 text-break" style="word-wrap: break-word; overflow-wrap: break-word;">@sessionInfo.FolderPath</code>
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                            @onclick="() => CopyToClipboard(sessionInfo.FolderPath, CopyKeyFolderPath)"
                                            title="@(copiedKey == CopyKeyFolderPath ? L["Common.Copied"] : L["SessionSettings.Info.CopyFolderPath"])">
                                        <i class="bi @(copiedKey == CopyKeyFolderPath ? "bi-check2 text-success" : "bi-clipboard")"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0 ms-1"
                                            @onclick="() => OpenFolder(sessionInfo.FolderPath)"
                                            title="@L["SessionSettings.Info.OpenFolder"]">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <small class="text-muted">@L["SessionSettings.Info.SessionId"]</small>
                                <div class="d-flex align-items-center">
                                    <code class="text-muted small">@sessionInfo.SessionId</code>
                                    <button type="button" class="btn btn-link btn-sm text-muted ms-2"
                                            @onclick="() => CopyToClipboard(sessionInfo.SessionId.ToString(), CopyKeySessionId)"
                                            title="@(copiedKey == CopyKeySessionId ? L["Common.Copied"] : L["SessionSettings.Info.CopySessionId"])">
                                        <i class="bi @(copiedKey == CopyKeySessionId ? "bi-check2 text-success" : "bi-clipboard") small"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2">
                        @if (!sessionInfo.ParentSessionId.HasValue)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="HandleCreateSubSession">
                                <i class="bi bi-plus-circle me-1"></i>@L["SessionSettings.CreateSubSession"]
                            </button>
                        }
                        @if (anyMemoExists)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenMemoManagement">
                                <i class="bi bi-journal-text me-1"></i>@L["SessionSettings.OpenMemoManagement"]
                            </button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenSessionCommandsDialog">
                            <i class="bi bi-terminal me-1"></i>@L["SessionSettings.Commands.ManageButton"]
                            @if (editingSessionCommands.Count > 0)
                            {
                                <span class="badge bg-secondary ms-1">@editingSessionCommands.Count</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenLinkPluginsDialogAsync">
                            <i class="bi bi-link-45deg me-1"></i>@L["SessionSettings.LinkPlugins.ManageButton"]
                            @if (editingLinkPlugins.Count(p => p.Enabled) > 0)
                            {
                                @* 有効な数だけ出す。同梱ぶんが常に一覧に並ぶので、総数だと常に数字が出て情報にならない *@
                                <span class="badge bg-secondary ms-1">@editingLinkPlugins.Count(p => p.Enabled)</span>
                            }
                        </button>
                    </div>

                    <hr />

                    <hr />

                    <!-- セッション名の変更 -->
                    <div class="mb-3">
                        <label class="form-label">@L["SessionSettings.DisplayName.Label"]</label>
                        <input type="text" class="form-control" @bind="displayName" placeholder="@L["SessionSettings.DisplayName.Placeholder"]" />
                        <small class="form-text text-muted">
                            @L["SessionSettings.DisplayName.Help"]
                        </small>
                    </div>

                    @if (!sessionInfo.ParentSessionId.HasValue)
                    {
                        <!-- ピン留め -->
                        <div class="mb-3">
                            <div class="form-check d-inline-block">
                                <input class="form-check-input" type="checkbox" @bind="isPinned" id="isPinnedCheck">
                                <label class="form-check-label" for="isPinnedCheck">
                                    <i class="bi bi-pin-fill me-1"></i>@L["SessionSettings.Pin.Label"]
                                </label>
                            </div>
                            @if (isPinned)
                            {
                                <div class="d-inline-block ms-3">
                                    <label class="form-label mb-0 me-1 small">@L["SessionSettings.Pin.PriorityLabel"]</label>
                                    <input type="number" class="form-control form-control-sm d-inline-block" style="width: 80px;"
                                           @bind="pinPriority" placeholder="--" />
                                </div>
                            }
                        </div>
                    }

                    <!-- メモ -->
                    <div class="mb-3">
                        <label class="form-label">@L["SessionSettings.Memo.Label"]</label>
                        <textarea class="form-control" @bind="memo" placeholder="@L["SessionSettings.Memo.Placeholder"]" rows="3"></textarea>
                        <small class="form-text text-muted">
                            @L["SessionSettings.Memo.Help"]
                        </small>
                    </div>

                    <!-- ターミナルタイプとオプション -->
                    <SessionOptionsSelector @ref="optionsSelector"
                                          SelectedType="selectedType"
                                          SelectedTypeChanged="OnTerminalTypeChanged"
                                          @bind-StartupCommand="startupCommand"
                                          ClaudeOptions="claudeOptions"
                                          GeminiOptions="geminiOptions"
                                          CodexOptions="codexOptions"
                                          AntigravityOptions="antigravityOptions"
                                          GrokOptions="grokOptions"
                                          DisableContinueOption="false" />

                    <ErrorAlert @bind-ErrorMessage="errorMessage" />
                }
                else
                {
                    <div class="text-center">
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        @L["SessionSettings.Loading"]
                    </div>
                }
            </div>
            <div class="modal-footer">
                <div class="form-check me-auto">
                    <input class="form-check-input" type="checkbox" @bind="restartSession" id="restartSessionCheck">
                    <label class="form-check-label" for="restartSessionCheck">
                        @L["SessionSettings.RestartOnSave"]
                    </label>
                </div>
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    @L["Common.Cancel"]
                </button>
                <button type="button" class="btn btn-primary" @onclick="SaveSettings" disabled="@(sessionInfo == null)">
                    <i class="bi bi-check-circle me-2"></i>@L["SessionSettings.Save"]
                </button>
            </div>
        </div>
    </div>
</div>

<MemoManagementDialog IsVisible="showMemoManagement"
                      SessionId="SessionId"
                      OnClose="CloseMemoManagement"
                      OnMemoRestored="HandleMemoRestored" />

<!-- セッション専用コマンド管理ダイアログ（編集バッファ editingSessionCommands を直接操作。本体ダイアログの保存で確定） -->
<div class="modal fade @(showSessionCommandsDialog ? "show" : "")" tabindex="-1" style="display: @(showSessionCommandsDialog ? "block" : "none"); background-color: var(--th-surface-overlay);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-terminal me-2"></i>@L["SessionSettings.Commands.Header"]
                </h5>
                <button type="button" class="btn-close" @onclick="CloseSessionCommandsDialog"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">@L["SessionSettings.Commands.Help"]</small>
                    <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0 ms-2" @onclick="OpenAddSessionCommand">
                        <i class="bi bi-plus-lg me-1"></i>@L["Settings.Commands.AddNew"]
                    </button>
                </div>

                @if (inheritedCommands.Any())
                {
                    <!-- 親から伝搬されてきたコマンド。ここでは編集できない（変更は親セッションの設定で行う） -->
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-arrow-down-square me-1"></i>@string.Format(L["SessionSettings.Commands.InheritedFormat"], inheritedCommands.Count)
                        </small>
                        <ul class="list-group list-group-sm">
                            @foreach (var inherited in inheritedCommands)
                            {
                                var inheritedIsKey = inherited.Type == CustomCommandType.KeySequence;
                                var inheritedBody = inheritedIsKey
                                    ? (KeySequencePresets.GetDisplayName(inherited.KeyName) ?? inherited.KeyName ?? "?")
                                    : SummarizeCommandText(inherited.CommandText);
                                <li class="list-group-item d-flex align-items-center py-1 px-2" style="background-color: var(--th-surface-raised);">
                                    <small class="d-flex align-items-center text-muted" style="min-width: 0; flex: 1;">
                                        @if (inheritedIsKey)
                                        {
                                            <i class="bi bi-keyboard me-1"></i>
                                        }
                                        @if (!string.IsNullOrEmpty(inherited.GroupName))
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-muted me-2" style="font-weight: normal;">@inherited.GroupName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(inherited.Title))
                                        {
                                            <strong>@inherited.Title</strong>
                                            <span class="ms-2 text-truncate">@inheritedBody</span>
                                        }
                                        else
                                        {
                                            <span class="text-truncate">@inheritedBody</span>
                                        }
                                    </small>
                                </li>
                            }
                        </ul>
                        <small class="form-text text-muted d-block">@L["SessionSettings.Commands.InheritedHelp"]</small>
                    </div>
                }

                @if (!string.IsNullOrEmpty(sessionCommandError))
                {
                    <div class="alert alert-warning py-1 px-2 mb-2" role="alert">
                        <small>@sessionCommandError</small>
                    </div>
                }

                @if (editingSessionCommands.Any())
                {
                    <ul class="list-group list-group-sm">
                        @for (var i = 0; i < editingSessionCommands.Count; i++)
                        {
                            var idx = i;
                            var cmd = editingSessionCommands[i];
                            var isKey = cmd.Type == CustomCommandType.KeySequence;
                            var bodyText = isKey
                                ? (KeySequencePresets.GetDisplayName(cmd.KeyName) ?? cmd.KeyName ?? "?")
                                : SummarizeCommandText(cmd.CommandText);
                            <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2">
                                <small class="d-flex align-items-center" style="min-width: 0; flex: 1;">
                                    @if (isKey)
                                    {
                                        <i class="bi bi-keyboard me-1 text-muted"></i>
                                    }
                                    @if (IsParentSession && cmd.PropagateToChildren)
                                    {
                                        <i class="bi bi-arrow-down-square me-1 text-primary" title="@L["Settings.Commands.Propagate"]"></i>
                                    }
                                    @if (cmd.CreatedByAgent)
                                    {
                                        <i class="bi bi-robot me-1 text-info" title="@L["Settings.Commands.CreatedByAgent"]"></i>
                                    }
                                    @if (!string.IsNullOrEmpty(cmd.GroupName))
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-muted me-2" style="font-weight: normal;">@cmd.GroupName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(cmd.Title))
                                    {
                                        <strong>@cmd.Title</strong>
                                        <span class="text-muted ms-2 text-truncate">@bodyText</span>
                                    }
                                    else
                                    {
                                        <span class="text-truncate">@bodyText</span>
                                    }
                                </small>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-outline-secondary btn-sm border-0" type="button"
                                            title="@L["Settings.Commands.Edit"]"
                                            @onclick="() => OpenEditSessionCommand(idx)" style="font-size: 0.75rem;">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm border-0" type="button"
                                            @onclick="() => RemoveSessionCommand(idx)" style="font-size: 0.7rem;">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0 fst-italic">@L["Settings.Commands.Empty"]</p>
                }
                <small class="form-text text-muted d-block mt-2">@L["SessionSettings.Commands.SaveHint"]</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseSessionCommandsDialog">
                    @L["Common.Close"]
                </button>
            </div>
        </div>
    </div>
</div>

<CommandEditDialog IsVisible="commandEditDialogVisible"
                   IsVisibleChanged="OnSessionCommandDialogVisibleChanged"
                   IsNew="commandEditDialogIsNew"
                   TerminalTypeLabel="@commandEditDialogTerminalLabel"
                   Command="commandEditDialogSource"
                   ShowPropagateOption="IsParentSession"
                   OnSave="HandleSessionCommandSave" />

<!-- リンクプラグイン管理ダイアログ（編集バッファ editingLinkPlugins を直接操作。本体ダイアログの保存で確定）
     出力中のトークンを URL リンクにする規則。採用・順序・変数をセッション単位で持つ -->
<div class="modal fade @(showLinkPluginsDialog ? "show" : "")" tabindex="-1" style="display: @(showLinkPluginsDialog ? "block" : "none"); background-color: var(--th-surface-overlay);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-link-45deg me-2"></i>@L["SessionSettings.LinkPlugins.Header"]
                </h5>
                <button type="button" class="btn-close" @onclick="CloseLinkPluginsDialog"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>@L["SessionSettings.LinkPlugins.Help"]
                </p>

                @* 「読む → 書かせる → 置く」をこの画面で完結させるための動線 *@
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenPluginsFolder">
                        <i class="bi bi-folder2-open me-1"></i>@L["SessionSettings.LinkPlugins.OpenFolder"]
                    </button>
                    @if (linkPluginDocAvailable)
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="/api/plugins/doc" target="_blank" rel="noopener">
                            <i class="bi bi-file-earmark-text me-1"></i>@L["SessionSettings.LinkPlugins.OpenDoc"]
                        </a>
                    }
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block text-break"><code>@pluginsFolderPath</code></small>
                    @* このフォルダで CLI の AI を動かして自作する導線。仕様は起動時にここへ置かれる *@
                    <small class="text-muted d-block">@string.Format(L["SessionSettings.LinkPlugins.FolderHelp"], LinkPluginDocPath.PluginsFolderFileName)</small>
                </div>

                @if (linkPluginCatalog.Count == 0)
                {
                    <p class="text-muted small mb-0">@L["SessionSettings.LinkPlugins.Empty"]</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var item in editingLinkPlugins)
                        {
                            var meta = linkPluginCatalog.FirstOrDefault(c => c.Id == item.Id);
                            var index = editingLinkPlugins.IndexOf(item);
                            <li class="list-group-item">
                                <div class="d-flex align-items-center">
                                    <div class="form-check flex-grow-1 mb-0">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@item.Enabled"
                                               @onchange="async e => await SetLinkPluginEnabled(item, e)"
                                               id="@($"plugin-{item.Id}")">
                                        <label class="form-check-label" for="@($"plugin-{item.Id}")">
                                            <code>@item.Id</code>
                                            @if (meta?.Source == "builtin")
                                            {
                                                <span class="badge text-bg-secondary ms-1">@L["SessionSettings.LinkPlugins.Builtin"]</span>
                                            }
                                            @if (meta == null)
                                            {
                                                <span class="badge text-bg-warning ms-1">@L["SessionSettings.LinkPlugins.Missing"]</span>
                                            }
                                        </label>
                                    </div>
                                    @* 上にあるものほど先に登録され、位置を取り合ったときに勝つ *@
                                    <button type="button" class="btn btn-outline-secondary btn-sm ms-1"
                                            title="@L["SessionSettings.LinkPlugins.MoveUp"]"
                                            disabled="@(index == 0)"
                                            @onclick="async () => await MoveLinkPlugin(item, -1)">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm ms-1"
                                            title="@L["SessionSettings.LinkPlugins.MoveDown"]"
                                            disabled="@(index == editingLinkPlugins.Count - 1)"
                                            @onclick="async () => await MoveLinkPlugin(item, 1)">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </div>
                                @if (item.Enabled && meta is not null && meta.Vars.Length > 0)
                                {
                                    <div class="mt-2 ms-4">
                                        @foreach (var name in meta.Vars)
                                        {
                                            <div class="input-group input-group-sm mb-1">
                                                <span class="input-group-text">@name</span>
                                                <input type="text" class="form-control"
                                                       value="@(item.Vars.TryGetValue(name, out var v) ? v : "")"
                                                       @onchange="async e => await SetLinkPluginVar(item, name, e)" />
                                            </div>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>

                    <hr />

                    @* 動作確認: 1行打って「何が引っかかって、どのリンクになるか」を見る。
                       実際の検出と同じ経路（matchPlugin）を通すので、ターミナルに出るまで待たなくていい *@
                    <h6 class="text-muted">@L["SessionSettings.LinkPlugins.Test.Header"]</h6>
                    @* 打つそばから結果が変わる。ボタンを押させると「試し忘れ」が起きるうえ、
                       正規表現を詰めていく作業は1文字ずつ確かめたいため *@
                    <input type="text" class="form-control form-control-sm mb-2"
                           value="@linkPluginTestLine"
                           @oninput="OnLinkPluginTestInputAsync"
                           placeholder="@L["SessionSettings.LinkPlugins.Test.Placeholder"]" />
                    @if (linkPluginTestResults != null)
                    {
                        @* 同梱の github-pr は origin から owner/repo を組み立てるため、
                           origin が無い・github 以外だと何も起きない。理由が分かるよう出す *@
                        <small class="text-muted d-block mb-1">
                            @if (string.IsNullOrEmpty(linkPluginTestOrigin))
                            {
                                @L["SessionSettings.LinkPlugins.Test.NoOrigin"]
                            }
                            else
                            {
                                @string.Format(L["SessionSettings.LinkPlugins.Test.Origin"], linkPluginTestOrigin)
                            }
                        </small>
                        @if (linkPluginTestResults.Count == 0)
                        {
                            <p class="text-muted small mb-0">@L["SessionSettings.LinkPlugins.Test.NoMatch"]</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-sm">
                                @foreach (var hit in linkPluginTestResults)
                                {
                                    <li class="list-group-item py-1 px-2 small @(hit.Won ? "" : "text-muted")">
                                        @if (hit.Error != null)
                                        {
                                            <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                                            <code>@hit.Id</code>
                                            <span class="ms-2">@hit.Error</span>
                                        }
                                        else
                                        {
                                            <code>@hit.Text</code>
                                            <i class="bi bi-arrow-right mx-2"></i>
                                            <span class="text-break">@hit.Url</span>
                                            <span class="badge bg-secondary bg-opacity-25 text-muted ms-2" style="font-weight: normal;">@hit.Id</span>
                                            @if (!hit.Won)
                                            {
                                                @* 同じ位置を先に取られている。実際の画面ではこちらは出ない *@
                                                <span class="badge text-bg-warning ms-1">@L["SessionSettings.LinkPlugins.Test.Overridden"]</span>
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseLinkPluginsDialog">
                    @L["Common.Close"]
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Guid? SessionId { get; set; }
    [Parameter] public EventCallback OnSettingsSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<Guid> OnCreateSubSession { get; set; }
    [Parameter] public EventCallback OnMemoRestored { get; set; }
    // 専用コマンドの即時保存通知（追加/編集/削除の都度、呼び出し元が DB へ永続化する）
    [Parameter] public EventCallback OnSessionCommandsChanged { get; set; }

    private bool showMemoManagement = false;
    private bool anyMemoExists = false;

    // セッション専用コマンドの編集用バッファ（保存時に sessionInfo へ書き戻す）
    private bool showSessionCommandsDialog = false;
    private List<CustomCommand> editingSessionCommands = new();

    // リンクプラグイン: 読み込まれているものの一覧（JS 側から取得）と、このセッションの設定（編集バッファ）
    private sealed record LinkPluginMeta(string Id, string Source, string File, string[] Vars);
    private List<LinkPluginMeta> linkPluginCatalog = new();
    private List<LinkPluginSetting> editingLinkPlugins = new();

    /// <summary>
    /// 読み込み済みプラグインとセッション設定を突き合わせて編集バッファを作る。
    /// 設定に無いものは未採用として末尾に足し、ファイルが消えたものも設定は保持する
    /// （置き直せば復活する。勝手に捨てると変数の再入力が要るため）。
    /// </summary>
    private async Task LoadLinkPluginsAsync(SessionInfo session)
    {
        await RefreshLinkPluginCatalogAsync();

        var saved = session.LinkPlugins.Select(p => new LinkPluginSetting
        {
            Id = p.Id,
            Enabled = p.Enabled,
            Order = p.Order,
            Vars = new Dictionary<string, string>(p.Vars)
        }).OrderBy(p => p.Order).ToList();

        // 一度も保存していないセッションは既定セット（同梱プラグイン）を有効として見せる。
        // ここで見えている状態がそのまま保存されるので、実際の適用（Root 側のフォールバック）と揃う。
        var untouched = session.LinkPlugins.Count == 0;

        foreach (var meta in linkPluginCatalog)
        {
            if (saved.Any(s => s.Id == meta.Id)) continue;
            saved.Add(new LinkPluginSetting
            {
                Id = meta.Id,
                Enabled = untouched && LinkPluginDefaults.IsDefaultEnabled(meta.Id),
                Order = saved.Count
            });
        }

        editingLinkPlugins = saved;
        linkPluginsUntouched = untouched;
    }

    /// <summary>
    /// 読み込み済みプラグインの一覧（カタログ）を取り直す。JS 側は呼ぶたびに .js を読み直すので、
    /// 「フォルダを開く → .js を足す → 画面を開き直す」で反映される。
    /// </summary>
    private async Task RefreshLinkPluginCatalogAsync()
    {
        try
        {
            var catalog = await JSRuntime.InvokeAsync<LinkPluginMeta[]>("listLinkPlugins");
            linkPluginCatalog = catalog.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[LinkPlugins] 一覧の取得に失敗");
            linkPluginCatalog = new();
        }
    }


    // ===== リンクプラグイン管理ダイアログ =====

    private bool showLinkPluginsDialog = false;
    // このセッションが一度も保存していないか（あとから増えた同梱プラグインの既定採用の判断に使う）
    private bool linkPluginsUntouched = false;
    private string pluginsFolderPath = "";
    private bool linkPluginDocAvailable = false;
    private string linkPluginTestLine = "";
    // 入力ごとに走らせると打鍵のたびに JS 往復が起きるので、最後の入力から少し待つ
    private int linkPluginTestInputSeq = 0;
    private List<LinkPluginTestHit>? linkPluginTestResults = null;
    // 直近のテストで使った origin。リンクにならない理由の大半がここなので画面に出す
    private string? linkPluginTestOrigin = null;

    private sealed record LinkPluginTestHit(string Id, string? Text, string? Url, int Start, bool Won, string? Error);

    /// <summary>
    /// 専用ダイアログを開く。開くたびにカタログを取り直し、増えた .js を一覧へ足す。
    /// 「フォルダを開く → .js を書く → この画面を開き直す」が主な導線なので、
    /// ここで読み直さないと外側の設定ごと閉じ直すまで反映されない。
    /// 編集中の採用・順序・変数（未保存）は保持し、差分だけを足し引きする。
    /// </summary>
    private async Task OpenLinkPluginsDialogAsync()
    {
        pluginsFolderPath = AppDataPaths.GetPluginsFolder();
        linkPluginDocAvailable = LinkPluginDocPath.Get() != null;
        showLinkPluginsDialog = true;

        await RefreshLinkPluginCatalogAsync();

        // 増えたものを末尾に足す。消えたものは残す（設定に無いファイルは
        // 「見つかりません」表示のまま。置き直せば復活し、変数の再入力も要らない）
        foreach (var meta in linkPluginCatalog)
        {
            if (editingLinkPlugins.Any(s => s.Id == meta.Id)) continue;
            editingLinkPlugins.Add(new LinkPluginSetting
            {
                Id = meta.Id,
                Enabled = linkPluginsUntouched && LinkPluginDefaults.IsDefaultEnabled(meta.Id),
                Order = editingLinkPlugins.Count
            });
        }

        // 前回の入力が残っているなら、増えた .js を含めて取り直す
        // （文字列だけ残って結果が消えていると「反映されていない」に見える）
        linkPluginTestResults = null;
        if (!string.IsNullOrEmpty(linkPluginTestLine))
        {
            await RunLinkPluginTestAsync();
        }
    }

    private void CloseLinkPluginsDialog()
    {
        showLinkPluginsDialog = false;
        // 待機中のタスクを無効化する（閉じたあとに走らせない）
        linkPluginTestInputSeq++;
    }

