    private void LoadSessionInfo()
    {
        if (!SessionId.HasValue)
            return;

        sessionInfo = SessionManager.GetSessionInfo(SessionId.Value);
        if (sessionInfo != null)
        {
            // 現在の設定を読み込む
            displayName = sessionInfo.DisplayName ?? "";
            memo = sessionInfo.Memo ?? "";
            isPinned = sessionInfo.IsPinned;
            pinPriority = sessionInfo.PinPriority;
            selectedType = sessionInfo.TerminalType;

            // セッション専用コマンドをディープコピーして編集バッファへ（キャンセル時に元を壊さない）
            editingSessionCommands = sessionInfo.SessionCommands
                .Select(c => new CustomCommand
                {
                    Title = c.Title,
                    CommandText = c.CommandText,
                    Type = c.Type,
                    KeyName = c.KeyName,
                    GroupName = c.GroupName,
                    SendMode = c.SendMode,
                    PropagateToChildren = c.PropagateToChildren,
                    // ダイアログを開いて保存しただけでフラグが消えないよう引き継ぐ。
                    // 落とすのは「その項目を編集したとき」だけ（OnCommandSaved 参照）。
                    CreatedByAgent = c.CreatedByAgent
                })
                .ToList();
            loadedSessionCommandTitles = editingSessionCommands
                .Where(c => !string.IsNullOrEmpty(c.Title))
                .Select(c => c.Title!)
                .ToHashSet(StringComparer.Ordinal);

            // 子セッションなら、親から伝搬されてくるコマンドを読み取り専用で見せるために取得する
            inheritedCommands = LoadInheritedCommands(sessionInfo);

            // オプションを解析
            var options = sessionInfo.Options;
            
            if (selectedType == TerminalType.Terminal && options.ContainsKey("command"))
            {
                startupCommand = options["command"];
            }
            else if (selectedType == TerminalType.ClaudeCode)
            {
                claudeOptions = new SessionOptionsSelector.ClaudeCodeOptions
                {
                    PermissionMode = options.ContainsKey("permission-mode")
                        ? options["permission-mode"]
                        : (options.ContainsKey("bypass-mode") && options["bypass-mode"] == "true")
                            ? "bypass"
                            : "default",
                    Continue = options.ContainsKey("continue") && options["continue"] == "true",
                    ChromeMode = options.ContainsKey("chrome") && options["chrome"] == "true",
                    ExtraArgs = options.ContainsKey("extra-args") ? options["extra-args"] : ""
                };
            }
            else if (selectedType == TerminalType.GeminiCLI)
            {
                geminiOptions = new SessionOptionsSelector.GeminiOptionsData
                {
                    SandboxMode = options.ContainsKey("sandbox") && options["sandbox"] == "true",
                    Continue = options.ContainsKey("continue") && options["continue"] == "true",
                    ExtraArgs = options.ContainsKey("extra-args") ? options["extra-args"] : "",
                    ApprovalMode = options.ContainsKey("approval-mode") ? options["approval-mode"] : "default"
                };
            }
            else if (selectedType == TerminalType.CodexCLI)
            {
                var savedMode = options.ContainsKey("mode") ? options["mode"] : "";
                var savedSandbox = options.ContainsKey("sandbox-mode") ? options["sandbox-mode"] : "";
                var savedApproval = options.ContainsKey("ask-for-approval") ? options["ask-for-approval"] : "";
                var savedApprovalsReviewer = options.ContainsKey("approvals-reviewer") ? options["approvals-reviewer"] : "";
                var savedWindowsSandbox = options.GetValueOrDefault("windows-sandbox", "");
                var savedNetworkAccess = options.GetValueOrDefault("network-access", "");
                var savedWebSearchMode = options.GetValueOrDefault("web-search-mode", "");
                if (string.IsNullOrEmpty(savedWebSearchMode) && options.GetValueOrDefault("search") == "true")
                {
                    savedWebSearchMode = "live";
                }
                // 旧「Auto」モードは空のサンドボックス/承認を BuildCodexArgs 側で
                // workspace-write / on-request に補完していた。モード廃止に伴い、その暗黙の
                // 既定を明示値として顕在化させ、再保存しても挙動が変わらないようにする。
                if (savedMode == "auto")
                {
                    if (string.IsNullOrEmpty(savedSandbox)) savedSandbox = "workspace-write";
                    if (string.IsNullOrEmpty(savedApproval)) savedApproval = "on-request";
                }
                var savedPreset = options.GetValueOrDefault("permission-preset");
                if (savedPreset == "codex-default")
                {
                    // 旧「Codex標準」は上書きなし。カスタムの全項目未指定として挙動を維持する。
                    savedPreset = "custom";
                    savedSandbox = "";
                    savedApproval = "";
                    savedApprovalsReviewer = "";
                    savedWindowsSandbox = "";
                    savedNetworkAccess = "";
                    savedWebSearchMode = "";
                }
                if (string.IsNullOrEmpty(savedPreset))
                {
                    savedPreset = savedSandbox == "workspace-write" && savedApproval == "on-request" &&
                         savedApprovalsReviewer == "auto_review" && savedWindowsSandbox == "elevated" &&
                         savedNetworkAccess == "true" && savedWebSearchMode == "live"
                        ? "recommended"
                        : savedSandbox == "workspace-write" && savedApproval == "on-request" &&
                          savedApprovalsReviewer == "user" && savedWindowsSandbox == "elevated" &&
                          savedNetworkAccess == "true" && savedWebSearchMode == "live"
                            ? "ask-for-approval"
                            : "custom";
                }
                codexOptions = new SessionOptionsSelector.CodexOptionsData
                {
                    Yolo = savedMode == "yolo",
                    PermissionPreset = savedMode == "yolo" ? "custom" : savedPreset,
                    ResumeLast = (options.ContainsKey("resume-last") && options["resume-last"] == "true")
                        || (options.ContainsKey("resume-picker") && options["resume-picker"] == "true"),
                    NoAltScreen = options.TryGetValue("no-alt-screen", out var noAltScreen) && noAltScreen == "true",
                    SandboxMode = savedSandbox,
                    ApprovalPolicy = savedApproval,
                    ApprovalReviewer = savedApprovalsReviewer,
                    WindowsSandbox = savedWindowsSandbox,
                    NetworkAccess = savedNetworkAccess,
                    WebSearchMode = savedWebSearchMode,
                    AdditionalDirectories = options.ContainsKey("add-dir") ? options["add-dir"] : "",
                    ExtraArgs = options.ContainsKey("extra-args") ? options["extra-args"] : ""
                };
            }
            else if (selectedType == TerminalType.Antigravity)
            {
                antigravityOptions = new SessionOptionsSelector.AntigravityOptionsData
                {
                    ExtraArgs = options.ContainsKey("extra-args") ? options["extra-args"] : ""
                };
            }
            else if (selectedType == TerminalType.Grok)
            {
                grokOptions = new SessionOptionsSelector.GrokOptionsData
                {
                    ExtraArgs = options.ContainsKey("extra-args") ? options["extra-args"] : ""
                };
            }
        }
    }

    private async Task SaveSettings()
    {
        if (sessionInfo == null || optionsSelector == null)
            return;

        try
        {
            // 表示名を更新
            sessionInfo.DisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName;

            // メモを更新
            sessionInfo.Memo = string.IsNullOrWhiteSpace(memo) ? string.Empty : memo;

            // ピン留め状態を更新
            sessionInfo.IsPinned = isPinned;
            sessionInfo.PinPriority = isPinned ? pinPriority : null;

            // ターミナルタイプを更新
            sessionInfo.TerminalType = selectedType;

            // オプションを更新
            sessionInfo.Options = optionsSelector.GetOptions();

            // セッション専用コマンドを書き戻す
            sessionInfo.SessionCommands = editingSessionCommands;

            // リンクプラグイン: 表示順をそのまま Order に落とす（上にあるものほど先に登録される）
            for (var i = 0; i < editingLinkPlugins.Count; i++) editingLinkPlugins[i].Order = i;
            sessionInfo.LinkPlugins = editingLinkPlugins;

            // 保存
            await SessionManager.SaveSessionInfoAsync(sessionInfo);

            // セッションを再起動する場合
            if (restartSession && SessionId.HasValue)
            {
                var success = await SessionManager.RestartSessionAsync(SessionId.Value);
                if (!success)
                {
                    errorMessage = L["SessionSettings.RestartFailed"];
                }
            }

            await OnSettingsSaved.InvokeAsync();
            if (string.IsNullOrEmpty(errorMessage))
            {
                errorMessage = "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(L["SessionSettings.SaveErrorFormat"], ex.Message);
        }
    }

