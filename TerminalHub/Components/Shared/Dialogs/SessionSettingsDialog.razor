    }

    private async Task OnLinkPluginTestInputAsync(ChangeEventArgs e)
    {
        linkPluginTestLine = e.Value?.ToString() ?? "";
        await ScheduleLinkPluginTestAsync();
    }

    /// <summary>
    /// 少し待ってから検出を走らせる。1文字ごと・チェックのたびに JS を呼ぶと往復が無駄なので、
    /// 最後の操作から一定時間空いたものだけ実行する。
    ///
    /// シーケンスは何よりも先に進める。空入力で先に return すると、直前の入力で待っている
    /// タスクが生き残り、消したあとに古い結果が表示される。
    /// </summary>
    private async Task ScheduleLinkPluginTestAsync()
    {
        var seq = ++linkPluginTestInputSeq;

        if (string.IsNullOrEmpty(linkPluginTestLine))
        {
            linkPluginTestResults = null;
            return;
        }

        await Task.Delay(250);
        if (seq != linkPluginTestInputSeq) return;   // 続けて操作されたので、こちらは捨てる

        await RunLinkPluginTestAsync();
        StateHasChanged();
    }

    /// <summary>
    /// テスト欄の1行に、いま編集中の採用・順序・変数をそのまま当てる。
    /// 検出は実際と同じ JS 側の matchPlugin を通る（テストは通るのに本番は違う、を避ける）。
    /// ctx も本番と同じものを押し込んでから走らせる（origin を見るプラグインが動かないため）。
    /// </summary>
    private async Task RunLinkPluginTestAsync()
    {
        if (sessionInfo == null) return;

        try
        {
            // IsGitRepository はセッション読み込み時の判定なので、これを条件にすると
            // あとから git init した場合などに取り逃す。リポジトリでなければ null が返るだけ
            var originUrl = await GitService.GetOriginUrlAsync(sessionInfo.FolderPath);
            linkPluginTestOrigin = originUrl;

            await JSRuntime.InvokeVoidAsync("setSessionPluginContext", sessionInfo.SessionId.ToString(), new
            {
                folderPath = sessionInfo.FolderPath,
                terminalType = sessionInfo.TerminalType.ToString(),
                git = new { originUrl, branch = sessionInfo.GitBranch }
            });

            var settings = editingLinkPlugins
                .Where(p => p.Enabled)
                .Select(p => new { id = p.Id, vars = p.Vars })
                .ToList();

            var hits = await JSRuntime.InvokeAsync<LinkPluginTestHit[]>(
                "testLinkPlugins", sessionInfo.SessionId.ToString(), linkPluginTestLine, settings);
            linkPluginTestResults = hits.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[LinkPlugins] テストの実行に失敗");
            linkPluginTestResults = new List<LinkPluginTestHit>
            {
                new("", null, null, 0, false, ex.Message)
            };
        }
    }

    // 採用・変数・順序はどれも結果を変える。変えたら追従しないと、
    // 「文字列を貼る → 変数を入れる」という普通の手順で古い結果を見ることになる
    private async Task SetLinkPluginEnabled(LinkPluginSetting item, ChangeEventArgs e)
    {
        item.Enabled = e.Value is bool b && b;
        await ScheduleLinkPluginTestAsync();
    }

    private async Task SetLinkPluginVar(LinkPluginSetting item, string name, ChangeEventArgs e)
    {
        item.Vars[name] = e.Value?.ToString() ?? "";
        await ScheduleLinkPluginTestAsync();
    }

    private async Task MoveLinkPlugin(LinkPluginSetting item, int delta)
    {
        var from = editingLinkPlugins.IndexOf(item);
        var to = from + delta;
        if (from < 0 || to < 0 || to >= editingLinkPlugins.Count) return;
        editingLinkPlugins.RemoveAt(from);
        editingLinkPlugins.Insert(to, item);
    }
